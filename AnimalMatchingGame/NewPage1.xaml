<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AnimalMatchingGame.NewPage1">

    <ContentPage.Background>

        <LinearGradientBrush
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop Color="#64D8FF"
                          Offset="0"/>

            <GradientStop Color="#81C784"
                          Offset="1"/>

        </LinearGradientBrush>

    </ContentPage.Background>

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="25">

            <!-- Cabeçalho -->

            <Border
                Background="#CCFFFFFF"
                StrokeThickness="0"
                Padding="20"
                StrokeShape="RoundRectangle 30">

                <VerticalStackLayout>

                    <Label
                        Text="🐾 Animal Matching"
                        FontSize="30"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Encontre todos os pares!"
                        FontSize="15"
                        Opacity=".7"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </Border>

            <!-- Painel de informações -->

            <Grid ColumnDefinitions="*,*">

                <Border
                    Grid.Column="0"
                    Margin="5"
                    Background="#FFB300"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20">

                    <Label
                        x:Name="TimeElapsed"
                        Text="⏱ 00:00"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="10"/>

                </Border>

                <Border
                    Grid.Column="1"
                    Margin="5"
                    Background="#5B4BFF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20">

                    <Button
    x:Name="PlayAgainButton"
    Text="🎮 Novo Jogo"
    WidthRequest="180"
    HeightRequest="55"
    CornerRadius="28"
    BackgroundColor="Transparent"
    TextColor="White"
    Clicked="PlayAgainButton_Clicked"/>

                </Border>

            </Grid>

            <!-- Área das cartas -->

            <FlexLayout
                x:Name="AnimalButtons"
                Wrap="Wrap"
                JustifyContent="Center"
                AlignItems="Center"
                MaximumWidthRequest="530"
                HorizontalOptions="Center">

                <!-- Mantenha seus 16 botões por enquanto -->
                <Button BackgroundColor="#5B4BFF"
                        TextColor="White"
                        CornerRadius="18"
                        WidthRequest="90"
                        HeightRequest="90"
                        Margin="6"
                        FontSize="42"
                        BorderWidth="0"
                        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>
                <Button BackgroundColor="#5B4BFF"
        TextColor="White"
        CornerRadius="18"
        WidthRequest="90"
        HeightRequest="90"
        Margin="6"
        FontSize="42"
        BorderWidth="0"
        Clicked="Button_Clicked"/>

                <!-- Repita os outros 15 botões com o mesmo estilo -->

            </FlexLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>